{
  "version": 2,
  "shape": "build-up",
  "question": "Should I replace my gas furnace with a heat pump?",
  "source": {
    "title": "Thinking about a heat pump? (synthetic test article)",
    "publisher": "Test fixture written for this repo, illustrative numbers",
    "quotes": [
      "a typical heat pump delivers about three units of heat for every unit of electricity it uses.",
      "A good gas furnace turns about 90 percent of its fuel into heat.",
      "Electricity usually costs more per unit of energy than gas, so the running cost depends on both prices where you live.",
      "Sealing and insulating first can shrink the heat you need, and lets you buy a smaller system."
    ]
  },
  "model": {
    "inputs": [
      {
        "id": "insulation",
        "label": "Heat saved by insulating first",
        "unit": "%",
        "kind": "lever",
        "min": 0,
        "max": 40,
        "step": 5,
        "default": 0,
        "source": "article",
        "quote": 3
      },
      {
        "id": "cop",
        "label": "Heat pump efficiency",
        "unit": "×",
        "kind": "lever",
        "min": 2,
        "max": 4.5,
        "step": 0.1,
        "default": 3,
        "source": "article",
        "quote": 0
      },
      {
        "id": "heatNeed",
        "label": "Heat your home needs a year",
        "unit": "kWh/yr",
        "kind": "condition",
        "min": 6000,
        "max": 30000,
        "step": 500,
        "default": 15000,
        "source": "assumption"
      },
      {
        "id": "elecPrice",
        "label": "Electricity price",
        "unit": "$/kWh",
        "kind": "condition",
        "min": 0.1,
        "max": 0.4,
        "step": 0.01,
        "default": 0.16,
        "source": "assumption"
      },
      {
        "id": "gasPrice",
        "label": "Gas price",
        "unit": "$/kWh",
        "kind": "condition",
        "min": 0.03,
        "max": 0.12,
        "step": 0.005,
        "default": 0.06,
        "source": "assumption"
      }
    ],
    "constants": [
      {
        "id": "furnaceEff",
        "label": "Gas furnace efficiency",
        "unit": "",
        "value": 0.9,
        "source": "article",
        "quote": 1
      },
      {
        "id": "installCost",
        "label": "Extra cost to install a heat pump",
        "unit": "$",
        "value": 8000,
        "source": "assumption"
      }
    ],
    "derived": [
      {
        "id": "heat",
        "label": "Heat needed after insulating",
        "unit": "kWh/yr",
        "formula": "heatNeed * (100 - insulation) / 100"
      },
      {
        "id": "gasCost",
        "label": "Yearly cost with gas",
        "unit": "$/yr",
        "formula": "heat / furnaceEff * gasPrice"
      },
      {
        "id": "hpCost",
        "label": "Yearly cost with a heat pump",
        "unit": "$/yr",
        "formula": "heat / cop * elecPrice"
      },
      {
        "id": "hpKwh",
        "label": "Electricity the heat pump uses",
        "unit": "kWh/yr",
        "formula": "heat / cop"
      }
    ],
    "outputs": [
      {
        "id": "saving",
        "label": "Saved each year",
        "unit": "$/yr",
        "formula": "gasCost - hpCost"
      }
    ],
    "stores": [
      {
        "id": "savings",
        "label": "Savings so far",
        "unit": "$",
        "start": 0,
        "change": "saving"
      }
    ],
    "milestones": [
      {
        "id": "paidBack",
        "label": "Extra cost paid back in",
        "store": "savings",
        "reaches": "installCost"
      }
    ]
  },
  "world": {
    "time": {
      "unit": "year",
      "span": 20
    },
    "nodes": [
      {
        "id": "winter",
        "prop": "cloud",
        "label": "Winter",
        "plays": "heatNeed",
        "sky": true
      },
      {
        "id": "grid",
        "prop": "power-pole",
        "label": "Electricity",
        "plays": "elecPrice"
      },
      {
        "id": "pump",
        "label": "Heat pump",
        "plays": "cop",
        "recipe": [
          {
            "shape": "box",
            "size": [
              1.5,
              1.1,
              0.7
            ],
            "color": "#e3e6e8"
          },
          {
            "shape": "torus",
            "size": [
              0.75,
              0.75,
              0.4
            ],
            "color": "#5b6b80",
            "at": [
              -0.2,
              0.17,
              0.36
            ]
          },
          {
            "shape": "box",
            "size": [
              0.3,
              0.5,
              0.06
            ],
            "color": "#8fae8b",
            "at": [
              0.48,
              0.3,
              0.36
            ]
          }
        ]
      },
      {
        "id": "home",
        "prop": "house",
        "label": "Your home",
        "plays": "insulation"
      },
      {
        "id": "gas",
        "prop": "factory",
        "label": "Gas company",
        "plays": "gasPrice"
      },
      {
        "id": "jar",
        "prop": "jar",
        "label": "Savings",
        "store": "savings",
        "target": "installCost"
      }
    ],
    "flows": [
      {
        "id": "elec",
        "from": "grid",
        "to": "pump",
        "carrier": "energy",
        "rate": "hpKwh",
        "label": "Electricity in",
        "unit": "kWh/yr"
      },
      {
        "id": "warmth",
        "from": "pump",
        "to": "home",
        "carrier": "energy",
        "rate": "heat",
        "label": "Heat moved in",
        "unit": "kWh/yr"
      },
      {
        "id": "leak",
        "from": "home",
        "to": "winter",
        "carrier": "heat",
        "rate": "heat",
        "label": "Heat lost through walls",
        "unit": "kWh/yr"
      },
      {
        "id": "gasStop",
        "from": "gas",
        "to": "jar",
        "carrier": "money",
        "rate": "gasCost",
        "label": "Gas bill you stop paying",
        "unit": "$/yr"
      },
      {
        "id": "elecBill",
        "from": "jar",
        "to": "grid",
        "carrier": "money",
        "rate": "hpCost",
        "label": "New electricity bill",
        "unit": "$/yr"
      }
    ]
  },
  "ask": [
    {
      "question": "How cold are your winters?",
      "help": "Sets how much heat a typical home needs in a year.",
      "choices": [
        {
          "label": "Mild",
          "set": {
            "heatNeed": 8000
          },
          "source": "assumption"
        },
        {
          "label": "Average",
          "set": {
            "heatNeed": 15000
          }
        },
        {
          "label": "Cold",
          "set": {
            "heatNeed": 25000
          },
          "source": "assumption"
        }
      ]
    },
    {
      "question": "What do you pay for electricity?",
      "help": "On your bill, per kWh.",
      "input": "elecPrice"
    },
    {
      "question": "Is gas cheap or pricey where you live?",
      "help": "Not sure? Pick About average. You can type your own price later.",
      "choices": [
        {
          "label": "Cheaper than most",
          "set": {
            "gasPrice": 0.04
          },
          "source": "assumption"
        },
        {
          "label": "About average",
          "set": {
            "gasPrice": 0.06
          }
        },
        {
          "label": "Pricier than most",
          "set": {
            "gasPrice": 0.09
          },
          "source": "assumption"
        }
      ]
    },
    {
      "question": "Will you insulate first?",
      "choices": [
        {
          "label": "No",
          "set": {
            "insulation": 0
          }
        },
        {
          "label": "A little",
          "set": {
            "insulation": 15
          }
        },
        {
          "label": "A lot",
          "set": {
            "insulation": 30
          }
        }
      ]
    }
  ],
  "explain": [
    {
      "shot": "establish",
      "caption": "Gas furnace or heat pump? Here is what decides it."
    },
    {
      "shot": "follow",
      "focus": "leak",
      "caption": "In winter, heat leaks out. You have to put it back."
    },
    {
      "shot": "follow",
      "focus": "warmth",
      "caption": "A heat pump runs on electricity, which usually costs more than gas."
    },
    {
      "shot": "turn",
      "focus": "elec",
      "caption": "But one unit of electricity moves about three units of heat."
    },
    {
      "shot": "cause",
      "focus": "gasStop",
      "drive": "gasPrice",
      "caption": "So you stop buying gas. Pricier gas means more saved."
    },
    {
      "shot": "cause",
      "focus": "elecBill",
      "drive": "elecPrice",
      "caption": "The electricity bill grows, and pricier power eats into savings."
    },
    {
      "shot": "focus",
      "focus": "home",
      "drive": "insulation",
      "caption": "Insulating first shrinks the heat you need at all."
    },
    {
      "shot": "timelapse",
      "focus": "jar",
      "caption": "Savings add up until they cover the extra cost."
    },
    {
      "shot": "handoff",
      "caption": "Now make it yours. Answer a few questions."
    }
  ],
  "simulate": {
    "controls": [
      "insulation",
      "cop",
      "heatNeed",
      "elecPrice",
      "gasPrice"
    ],
    "prompt": "Try your own prices and your own winter."
  },
  "decide": {
    "compare": [
      {
        "label": "Heat pump as it is",
        "set": {
          "insulation": 0
        }
      },
      {
        "label": "Insulate 25% first",
        "set": {
          "insulation": 25
        }
      }
    ],
    "tradeoffs": [
      "Lower running costs are likely where gas is expensive, but not guaranteed where electricity is.",
      "A heat pump also cools in summer, but installation can cost more than a new furnace.",
      "Insulating first costs money too, but can mean a smaller, cheaper system."
    ],
    "leftOut": [
      "Rebates and tax credits. These change, so check what applies to you now.",
      "Lower efficiency on the coldest days, and any backup heat you might need.",
      "Duct or electrical panel upgrades your home might need.",
      "Emissions, which depend on how your electricity is made."
    ],
    "questionsToAsk": [
      "Which cold-climate models do installers recommend for my area?",
      "Do my ducts or electrical panel need work?",
      "What rebates are available where I live?",
      "What would insulating first change about the system size?"
    ]
  },
  "checks": [
    {
      "claim": "A typical heat pump delivers about three units of heat for every unit of electricity",
      "value": "hpKwh",
      "between": [
        4500,
        5500
      ],
      "quote": 0
    },
    {
      "claim": "At typical prices, running a heat pump costs within a few hundred dollars a year of running a gas furnace",
      "value": "saving",
      "between": [
        -600,
        900
      ],
      "reason": "Illustrative fixture: with these prices the two running costs should be close, not thousands apart."
    },
    {
      "claim": "Running cost depends on both prices: dearer gas makes the switch save more",
      "value": "saving",
      "rises": "gasPrice"
    },
    {
      "claim": "Dearer electricity makes the switch save less",
      "value": "saving",
      "falls": "elecPrice"
    },
    {
      "claim": "Insulating first shrinks the heat you need",
      "value": "heat",
      "falls": "insulation"
    }
  ]
}
