          "quote": [
            7,
            9
          ]
        }
      ]
    },
    {
      "question": "When are you usually at home?",
      "help": "Panels make power in the daytime. Power used then saves the most.",
      "choices": [
        {
          "label": "Out most days",
          "set": {
            "selfUse": 30
          }
        },
        {
          "label": "Home some days",
          "set": {
            "selfUse": 40
          }
        },
        {
          "label": "Home most days",
          "set": {
            "selfUse": 65
          }
        }
      ]
    },
    {
      "question": "What should happen to solar power you don't use straight away?",
      "choices": [
        {
          "label": "Send it to the grid for a credit",
          "set": {
            "battery": 0
          }
        },
        {
          "label": "Store it in a home battery",
          "set": {
            "battery": 10
          }
        }
      ]
    },
    {
      "question": "What does your utility pay for power you send out?",
      "help": "Ask about net metering or net billing. It is often much less than you pay.",
      "input": "exportRate"
    }
  ],
  "explain": [
    {
      "shot": "establish",
      "caption": "Your roof sits in the sun all day. Could it pay you?"
    },
    {
      "shot": "follow",
      "focus": "light",
      "caption": "Morning. Sunlight lands on your panels."
    },
    {
      "shot": "follow",
      "focus": "direct",
      "caption": "Your home runs on it. That's power you don't buy."
    },
    {
      "shot": "cause",
      "focus": "avoided",
      "caption": "So every unit you don't buy drops into your savings."
    },
    {
      "shot": "follow",
      "focus": "export",
      "caption": "By noon there's spare power. You sell it to the grid."
    },
    {
      "shot": "turn",
      "focus": "credit",
      "caption": "But the grid usually pays far less than you pay it."
    },
    {
      "shot": "cause",
      "focus": "charge",
      "drive": "battery",
      "caption": "A battery keeps the spare for the evening instead."
    },
    {
      "shot": "follow",
      "focus": "import",
      "caption": "After dark, you still buy some power from the grid."
    },
    {
      "shot": "timelapse",
      "focus": "jar",
      "caption": "Year by year, savings climb until they cover the cost."
    },
    {
      "shot": "focus",
      "focus": "home",
      "caption": "Use more of it at home, and that day comes sooner."
    },
    {
      "shot": "handoff",
      "caption": "Now it is your roof. Your numbers decide the rest."
    }
  ],
  "simulate": {
    "controls": [
      "size",
      "battery",
      "selfUse",
      "monthlyBill",
      "exportRate",
      "costPerKw"
    ],
    "prompt": "Try your own roof, bill and prices."
  },
  "decide": {
    "compare": [
      {
        "label": "Solar, no battery",
        "set": {
          "battery": 0
        }
      },
      {
        "label": "Solar + 10 kWh battery",
        "set": {
          "battery": 10
        }
      }
    ],
    "tradeoffs": [
      "Paying cash usually costs less in total than a loan, lease or power purchase agreement.",
      "A battery adds about $15,000, keeps more of your own power, and can run the house in an outage. On savings alone it rarely pays for itself.",
      "A bigger system makes more power, but power you send out usually earns less than power you use."
    ],
    "leftOut": [
      "Tax credits and rebates. These change often, so check what applies where you live today.",
      "Shade and roof direction. South-facing roofs at 15–40 degrees usually do best.",
      "Panel wear, battery replacement, and power prices changing over the years.",
      "Replacing your roof during the life of the panels."
    ],
    "questionsToAsk": [
      "How does my utility credit the power I send to the grid?",
      "How many years until my roof needs replacing?",
      "Can I get at least three quotes from certified installers?",
      "Which incentives apply to me right now?"
    ]
  },
  "checks": [
    {
      "claim": "Systems average about $2.60 per watt, so a 7 kW system costs about $18,200 before incentives",
      "value": "cost",
      "between": [
        16000,
        20000
      ],
      "quote": 9
    },
    {
      "claim": "A typical home system pays for itself within its 25-year life",
      "value": "paidBack",
      "between": [
        5,
        25
      ],
      "reason": "Home solar usually pays back in roughly 6 to 20 years; a result outside 5 to 25 years at typical values means the model is wrong."
    },
    {
      "claim": "Every unit the panels make is used, stored or sent to the grid",
      "same": [
        "yearlyKwh",
        "direct + shifted / roundTrip + exportedKwh"
      ]
    },
    {
      "claim": "A bigger system saves more each year",
      "value": "saving",
      "rises": "size"
    },
    {
      "claim": "More sun means a shorter payback",
      "value": "paidBack",
      "falls": "sunHours"
    },
    {
      "claim": "Savings also depend on the electricity rates set by your utility",
      "value": "saving",
      "rises": "price"
    }
  ]
}
