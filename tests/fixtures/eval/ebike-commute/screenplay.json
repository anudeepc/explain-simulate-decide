{
  "version": 2,
  "shape": "conversion",
  "question": "Should I commute by e-bike instead of by car?",
  "source": {
    "title": "Car or e-bike for the daily commute?",
    "publisher": "Test fixture written for this repo, illustrative numbers",
    "quotes": [
      "A typical petrol car uses about 7 litres of fuel per 100 kilometres.",
      "Burning a litre of petrol releases about 2.3 kilograms of carbon dioxide, so each kilometre adds about 160 grams of CO2.",
      "Petrol costs around $1.90 a litre.",
      "An e-bike uses roughly 1 kilowatt hour of electricity for every 100 kilometres: about one hundredth of the energy.",
      "On an average grid, a kilowatt hour causes about 0.5 kilograms of CO2, so an e-bike kilometre causes about 5 grams.",
      "A kilowatt hour costs around 30 cents.",
      "For a 10 kilometre commute each way, five days a week, 46 weeks a year, the car burns about 320 litres of petrol a year and emits about 740 kilograms of CO2.",
      "The e-bike uses about 46 kilowatt hours.",
      "They don't: even counting the electricity, the e-bike emits a few percent of the car's CO2 for the same trip.",
      "An e-bike costs around $2,500 and needs servicing.",
      "It does not suit every trip: heavy loads, bad weather and long distances still favour the car.",
      "Many households keep the car and use the e-bike for most commutes."
    ]
  },
  "model": {
    "inputs": [
      {
        "id": "bikeShare",
        "label": "Commute trips by e-bike",
        "unit": "%",
        "kind": "lever",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 80,
        "source": "assumption"
      },
      {
        "id": "distance",
        "label": "Distance each way",
        "unit": "km/trip",
        "kind": "lever",
        "min": 1,
        "max": 30,
        "step": 1,
        "default": 10,
        "source": "article",
        "quote": 6
      },
      {
        "id": "days",
        "label": "Commute days a week",
        "unit": "days/week",
        "kind": "lever",
        "min": 1,
        "max": 7,
        "step": 1,
        "default": 5,
        "source": "article",
        "quote": 6
      },
      {
        "id": "petrolPrice",
        "label": "Petrol price",
        "unit": "$/L",
        "kind": "condition",
        "min": 1.2,
        "max": 3,
        "step": 0.05,
        "default": 1.9,
        "source": "article",
        "quote": 2
      },
      {
        "id": "powerPrice",
        "label": "Electricity price",
        "unit": "$/kWh",
        "kind": "condition",
        "min": 0.1,
        "max": 0.6,
        "step": 0.01,
        "default": 0.3,
        "source": "article",
        "quote": 5
      },
      {
        "id": "carFuel",
        "label": "Car's fuel use",
        "unit": "L/100 km",
        "kind": "condition",
        "min": 4,
        "max": 12,
        "step": 0.5,
        "default": 7,
        "source": "article",
        "quote": 0
      },
      {
        "id": "gridCO2",
        "label": "CO2 per unit of electricity",
        "unit": "kg/kWh",
        "kind": "condition",
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 0.5,
        "source": "article",
        "quote": 4
      }
    ],
    "constants": [
      {
        "id": "legs",
        "label": "Trips each commute day (there and back)",
        "unit": "trips/day",
        "value": 2,
        "source": "article",
        "quote": 6
      },
      {
        "id": "weeks",
        "label": "Commute weeks a year",
        "unit": "weeks/yr",
        "value": 46,
        "source": "article",
        "quote": 6
      },
      {
        "id": "co2PerLitre",
        "label": "CO2 from burning a litre of petrol",
        "unit": "kg/L",
        "value": 2.3,
        "source": "article",
        "quote": 1
      },
      {
        "id": "bikeUse",
        "label": "E-bike's electricity use",
        "unit": "kWh/100 km",
        "value": 1,
        "source": "article",
        "quote": 3
      },
      {
        "id": "bikeCost",
        "label": "E-bike price",
        "unit": "$",
        "value": 2500,
        "source": "article",
        "quote": 9
      },
      {
        "id": "serviceRate",
        "label": "E-bike servicing per 1,000 km",
        "unit": "$/1000 km",
        "value": 30,
        "source": "assumption"
      }
    ],
    "derived": [
      {
        "id": "totalKm",
        "label": "Commute distance a year",
        "unit": "km/yr",
        "formula": "distance * legs * days * weeks"
      },
      {
        "id": "bikeKm",
        "label": "Kilometres by e-bike",
        "unit": "km/yr",
        "formula": "totalKm * bikeShare / 100"
      },
      {
        "id": "carKm",
        "label": "Kilometres by car",
        "unit": "km/yr",
        "formula": "totalKm - bikeKm"
      },
      {
        "id": "carLitres",
        "label": "Petrol the car burns",
        "unit": "L/yr",
        "formula": "carKm * carFuel / 100"
      },
      {
        "id": "carCO2",
        "label": "CO2 from the car",
        "unit": "kg/yr",
        "formula": "carLitres * co2PerLitre"
      },
      {
        "id": "bikeKwh",
        "label": "Electricity the e-bike uses",
        "unit": "kWh/yr",
        "formula": "bikeKm * bikeUse / 100"
      },
      {
        "id": "bikeCO2",
        "label": "CO2 from charging",
        "unit": "kg/yr",
        "formula": "bikeKwh * gridCO2"
      },
      {
        "id": "fuelCost",
        "label": "Petrol bill",
        "unit": "$/yr",
        "formula": "carLitres * petrolPrice"
      },
      {
        "id": "powerCost",
        "label": "Charging bill",
        "unit": "$/yr",
        "formula": "bikeKwh * powerPrice"
      },
      {
        "id": "service",
        "label": "E-bike servicing",
        "unit": "$/yr",
        "formula": "bikeKm * serviceRate / 1000"
      },
      {
        "id": "fuelSaved",
        "label": "Petrol you don't buy",
        "unit": "$/yr",
        "formula": "bikeKm * carFuel / 100 * petrolPrice"
      },
      {
        "id": "carPerKm",
        "label": "Car CO2 per km",
        "unit": "g/km",
        "formula": "carFuel * co2PerLitre * 10"
      },
      {
        "id": "bikePerKm",
        "label": "E-bike CO2 per km",
        "unit": "g/km",
        "formula": "bikeUse * gridCO2 * 10"
      },
      {
        "id": "co2Ratio",
        "label": "E-bike CO2 as a share of the car's",
        "unit": "%",
        "formula": "bikePerKm / max(carPerKm, 1) * 100"
      }
    ],
    "outputs": [
      {
        "id": "co2Year",
        "label": "CO2 from your commute",
        "unit": "kg/yr",
        "formula": "carCO2 + bikeCO2"
      },
      {
        "id": "costYear",
        "label": "Running cost of your commute",
        "unit": "$/yr",
        "formula": "fuelCost + powerCost + service"
      }
    ],
    "stores": [
      {
        "id": "savings",
        "label": "Saved so far",
        "unit": "$",
        "start": 0,
        "change": "fuelSaved - powerCost - service"
      }
    ],
    "milestones": [
      {
        "id": "paidBack",
        "label": "E-bike paid for in",
        "store": "savings",
        "reaches": "bikeCost"
      }
    ]
  },
  "checks": [
    {
      "claim": "Driving the whole commute burns about 320 litres of petrol a year",
      "value": "carLitres",
      "between": [
        300,
        340
      ],
      "when": {
        "bikeShare": 0
      },
      "quote": 6
    },
    {
      "claim": "Driving the whole commute emits about 740 kilograms of CO2 a year",
      "value": "carCO2",
      "between": [
        700,
        780
      ],
      "when": {
        "bikeShare": 0
      },
      "quote": 6
    },
    {
      "claim": "Riding the whole commute uses about 46 kilowatt hours a year",
      "value": "bikeKwh",
      "between": [
        43,
        49
      ],
      "when": {
        "bikeShare": 100
      },
      "quote": 7
    },
    {
      "claim": "Each car kilometre adds about 160 grams of CO2",
      "value": "carPerKm",
      "between": [
        150,
        170
      ],
      "quote": 1
    },
    {
      "claim": "Each e-bike kilometre causes about 5 grams of CO2",
      "value": "bikePerKm",
      "between": [
        4,
        6
      ],
      "quote": 4
    },
    {
      "claim": "Even counting the electricity, the e-bike emits a few percent of the car's CO2",
      "value": "co2Ratio",
      "between": [
        1,
        6
      ],
      "quote": 8
    },
    {
      "claim": "Moving trips to the e-bike cuts CO2",
      "value": "co2Year",
      "falls": "bikeShare"
    },
    {
      "claim": "Moving trips to the e-bike cuts running costs",
      "value": "costYear",
      "falls": "bikeShare"
    },
    {
      "claim": "A longer commute emits more CO2",
      "value": "co2Year",
      "rises": "distance"
    },
    {
      "claim": "Dearer petrol means more saved by riding",
      "value": "fuelSaved",
      "rises": "petrolPrice"
    },
    {
      "claim": "Every commute kilometre is ridden or driven",
      "same": [
        "totalKm",
        "carKm + bikeKm"
      ]
    }
  ],
