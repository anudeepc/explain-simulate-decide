  "ask": [
    {
      "question": "How far is your commute, one way?",
      "help": "A map app shows the distance from home to work, in km.",
      "input": "distance"
    },
    {
      "question": "What does petrol cost near you, per litre?",
      "help": "It's on the sign at your local petrol station.",
      "input": "petrolPrice"
    },
    {
      "question": "How big is your car's thirst?",
      "help": "Small cars use less fuel; big cars and 4WDs use more.",
      "choices": [
        {
          "label": "Small car",
          "set": {
            "carFuel": 5
          },
          "source": "assumption"
        },
        {
          "label": "Average, or not sure",
          "set": {
            "carFuel": 7
          },
          "quote": 0
        },
        {
          "label": "Large car or 4WD",
          "set": {
            "carFuel": 10
          },
          "source": "assumption"
        }
      ]
    },
    {
      "question": "How many of your commutes could the e-bike take?",
      "choices": [
        {
          "label": "Every trip",
          "set": {
            "bikeShare": 100
          }
        },
        {
          "label": "Most trips, or not sure",
          "set": {
            "bikeShare": 80
          },
          "quote": 11
        },
        {
          "label": "About half",
          "set": {
            "bikeShare": 50
          }
        },
        {
          "label": "Fine days only",
          "set": {
            "bikeShare": 30
          }
        }
      ]
    },
    {
      "question": "How is your electricity made?",
      "help": "Your power company's website or bill often shows its mix.",
      "choices": [
        {
          "label": "Mostly coal or gas",
          "set": {
            "gridCO2": 0.8
          },
          "source": "assumption"
        },
        {
          "label": "A mix, or not sure",
          "set": {
            "gridCO2": 0.5
          },
          "quote": 4
        },
        {
          "label": "Mostly wind, sun or water",
          "set": {
            "gridCO2": 0.1
          },
          "source": "assumption"
        }
      ]
    }
  ],
  "explain": [
    {
      "shot": "establish",
      "caption": "Car or e-bike to work? Both turn energy into distance."
    },
    {
      "shot": "follow",
      "focus": "petrol",
      "caption": "The car burns petrol to carry you to work."
    },
    {
      "shot": "follow",
      "focus": "carSmoke",
      "caption": "Burning petrol puts carbon dioxide, CO2, into the air."
    },
    {
      "shot": "follow",
      "focus": "charge",
      "caption": "The e-bike runs on a little electricity from the grid."
    },
    {
      "shot": "turn",
      "focus": "gridSmoke",
      "caption": "But charging adds only a trickle of CO2 beside the car's."
    },
    {
      "shot": "cause",
      "focus": "byBike",
      "drive": "bikeShare",
      "caption": "Move more trips to the e-bike, and the car's streams shrink."
    },
    {
      "shot": "follow",
      "focus": "notBought",
      "caption": "Petrol you don't buy goes into savings."
    },
    {
      "shot": "follow",
      "focus": "chargeBill",
      "caption": "Charging and servicing take a little back out."
    },
    {
      "shot": "timelapse",
      "focus": "jar",
      "caption": "Savings build up until they cover the e-bike's price."
    },
    {
      "shot": "handoff",
      "caption": "Now make it yours. Answer a few questions."
    }
  ],
  "simulate": {
    "controls": [
      "bikeShare",
      "distance",
      "days",
      "petrolPrice",
      "powerPrice",
      "gridCO2"
    ],
    "prompt": "Try your own trip, your own prices and your own grid."
  },
  "decide": {
    "compare": [
      {
        "label": "Keep driving",
        "set": {
          "bikeShare": 0
        }
      },
      {
        "label": "E-bike for most trips",
        "set": {
          "bikeShare": 80
        }
      },
      {
        "label": "E-bike every trip",
        "set": {
          "bikeShare": 100
        }
      }
    ],
    "tradeoffs": [
      "An e-bike costs around $2,500 up front, but costs little to run for each trip.",
      "Riding cuts petrol and CO2, but heavy loads, bad weather and long trips still favour the car.",
      "Keeping the car for some trips gives flexibility, but each car trip burns far more energy."
    ],
    "leftOut": [
      "Insurance, registration, parking and wear on the car, which may not change if you keep it.",
      "Servicing cost is a guess here; ask a bike shop what it charges.",
      "Emissions from making the car, the e-bike and its battery.",
      "Petrol and power prices change often; check what you pay now.",
      "Rebates for e-bikes, which vary by place; check what applies to you.",
      "Time on the road, health, and the safety of your route."
    ],
    "questionsToAsk": [
      "What does servicing this e-bike cost each year?",
      "How long does the battery last, and what does a new one cost?",
      "Is there a safe route and secure bike parking at work?",
      "Does my power company offer a cleaner electricity plan?"
    ]
  }
}
