{
  "version": 2,
  "shape": "build-up",
  "question": "Will a rainwater tank keep my garden watered through summer?",
  "source": {
    "title": "Is a rainwater tank worth it for your garden?",
    "publisher": "Test fixture (illustrative numbers)",
    "quotes": [
      "A rainwater tank collects water from your roof so you can use it in the garden instead of tap water.",
      "As a rule of thumb, every square metre of roof collects about one litre of water for every millimetre of rain, minus some loss to gutters and first-flush diverters, typically around 20%.",
      "A 100 square metre roof in a place with 600 millimetres of rain a year can collect roughly 48,000 litres a year.",
      "A typical garden in summer uses around 200 litres a day when watered by hand.",
      "A small 2,000 litre tank fills and overflows in a single big storm and can be empty within ten dry days.",
      "A 10,000 litre tank lasts most of a dry spell, but costs more and takes up space.",
      "Many owners find a tank of 5,000 litres is a good middle ground for a small garden.",
      "In most places it covers the wet months easily and runs dry in exactly the weeks you need it most.",
      "In a dry summer the garden takes water out faster than rain puts it in, and the tank runs empty.",
      "Tanks also need a pump, cleaning, and in some areas a permit."
    ]
  },
  "model": {
    "inputs": [
      {
        "id": "tankSize",
        "label": "Tank size",
        "unit": "L",
        "kind": "lever",
        "min": 2000,
        "max": 10000,
        "step": 500,
        "default": 5000,
        "source": "article",
        "quote": 6
      },
      {
        "id": "gardenUse",
        "label": "Water your garden uses in summer",
        "unit": "L/day",
        "kind": "lever",
        "min": 50,
        "max": 400,
        "step": 10,
        "default": 200,
        "source": "article",
        "quote": 3
      },
      {
        "id": "roofArea",
        "label": "Roof area that drains to the tank",
        "unit": "m²",
        "kind": "condition",
        "min": 20,
        "max": 300,
        "step": 10,
        "default": 100,
        "source": "article",
        "quote": 2
      },
      {
        "id": "annualRain",
        "label": "Rain in a year",
        "unit": "mm/yr",
        "kind": "condition",
        "min": 200,
        "max": 1500,
        "step": 50,
        "default": 600,
        "source": "article",
        "quote": 2
      },
      {
        "id": "summerRain",
        "label": "Rain in a summer month",
        "unit": "mm/month",
        "kind": "condition",
        "min": 0,
        "max": 120,
        "step": 5,
        "default": 15,
        "source": "assumption"
      }
    ],
    "constants": [
      {
        "id": "litresPerMm",
        "label": "Water from each square metre per millimetre of rain",
        "unit": "L/m²/mm",
        "value": 1,
        "source": "article",
        "quote": 1
      },
      {
        "id": "lossPct",
        "label": "Lost to gutters and first-flush diverters",
        "unit": "%",
        "value": 20,
        "source": "article",
        "quote": 1
      },
      {
        "id": "drawRate",
        "label": "Share of the tank's water a pump can give in a day",
        "unit": "%/day",
        "value": 100,
        "source": "assumption"
      },
      {
        "id": "summerDays",
        "label": "Length of a summer dry spell",
        "unit": "day",
        "value": 60,
        "source": "assumption"
      }
    ],
    "derived": [
      {
        "id": "keepShare",
        "label": "Share of roof water kept",
        "unit": "",
        "formula": "1 - lossPct / 100"
      },
      {
        "id": "rainOnRoof",
        "label": "Summer rain on the roof",
        "unit": "L/day",
        "formula": "roofArea * summerRain / 30 * litresPerMm"
      },
      {
        "id": "summerInflow",
        "label": "Summer water into the tank",
        "unit": "L/day",
        "formula": "rainOnRoof * keepShare"
      },
      {
        "id": "gutterLoss",
        "label": "Summer water lost in gutters",
        "unit": "L/day",
        "formula": "rainOnRoof - summerInflow"
      },
      {
        "id": "summerNeed",
        "label": "Water the garden needs all summer",
        "unit": "L",
        "formula": "gardenUse * summerDays"
      },
      {
        "id": "fromTank",
        "label": "Summer watering from the tank",
        "unit": "L",
        "formula": "min(summerNeed, tankSize + summerInflow * summerDays)"
      },
      {
        "id": "tapNeeded",
        "label": "Tap water still needed in summer",
        "unit": "L",
        "formula": "summerNeed - fromTank"
      }
    ],
    "outputs": [
      {
        "id": "yearCollect",
        "label": "Water collected in a year",
        "unit": "L/yr",
        "formula": "roofArea * annualRain * litresPerMm * keepShare"
      },
      {
        "id": "coverPct",
        "label": "Summer watering the tank covers",
        "unit": "%",
        "formula": "fromTank / max(summerNeed, 1) * 100"
      }
    ],
    "stores": [
      {
        "id": "tank",
        "label": "Water in the tank",
        "unit": "L",
        "start": "tankSize",
        "change": "min(summerInflow - gardenUse, (tankSize - tank) * drawRate / 100)",
        "floor": 0
      }
    ],
    "milestones": [
      {
        "id": "runsDry",
        "label": "Tank runs dry after",
        "store": "tank",
        "reaches": "0"
      }
    ]
  },
  "checks": [
    {
      "claim": "A 100 square metre roof with 600 mm of rain a year collects roughly 48,000 litres",
      "value": "yearCollect",
      "between": [
        45000,
        50000
      ],
      "quote": 2
    },
    {
      "claim": "A 2,000 litre tank can be empty within ten dry days",
      "value": "runsDry",
      "between": [
        5,
        10
      ],
      "when": {
        "tankSize": 2000,
        "summerRain": 0
      },
      "quote": 4
    },
    {
      "claim": "A 10,000 litre tank lasts most of a dry spell",
      "value": "coverPct",
      "between": [
        75,
        100
      ],
      "when": {
        "tankSize": 10000
      },
      "quote": 5
    },
    {
      "claim": "In most places the tank runs dry in the weeks you need it most",
      "value": "coverPct",
      "between": [
        0,
        99
      ],
      "quote": 7
    },
    {
      "claim": "A bigger tank lasts longer",
      "value": "runsDry",
      "rises": "tankSize"
    },
    {
      "claim": "A thirstier garden empties the tank sooner",
      "value": "runsDry",
      "falls": "gardenUse"
    },
    {
      "claim": "A bigger tank covers more of the summer watering",
      "value": "coverPct",
      "rises": "tankSize"
    },
    {
      "claim": "More roof means less tap water in summer",
      "value": "tapNeeded",
      "falls": "roofArea"
    },
    {
      "claim": "Summer watering comes from the tank or the tap",
      "same": [
        "fromTank + tapNeeded",
        "summerNeed"
      ]
    },
    {
      "claim": "Rain on the roof goes into the tank or is lost in the gutters",
      "same": [
        "rainOnRoof",
        "summerInflow + gutterLoss"
      ]
    }
  ],
  "world": {
    "time": {
      "unit": "day",
      "span": 60
    },
    "nodes": [
      {
        "id": "cloud",
        "prop": "cloud",
        "label": "Summer rain",
        "plays": "summerRain",
        "sky": true
      },
      {
        "id": "home",
        "prop": "house",
        "label": "Your roof",
        "plays": "roofArea"
      },
      {
        "id": "tankNode",
        "prop": "tank",
        "label": "Rainwater tank",
        "store": "tank",
        "target": "tankSize"
      },
      {
        "id": "garden",
        "prop": "hill",
        "label": "Your garden",
        "plays": "gardenUse"
      },
      {
        "id": "mains",
        "prop": "water-drop",
        "label": "Tap water",
        "plays": "tapNeeded"
      },
      {
        "id": "drain",
        "kind": "other",
        "label": "Storm drain"
      }
    ],
    "flows": [
      {
        "id": "rain",
        "from": "cloud",
        "to": "home",
        "carrier": "water",
        "rate": "rainOnRoof",
        "label": "Rain on your roof",
        "unit": "L/day"
      },
      {
        "id": "collected",
        "from": "home",
        "to": "tankNode",
        "carrier": "water",
        "rate": "summerInflow",
        "label": "Into the tank",
        "unit": "L/day"
      },
      {
        "id": "lost",
        "from": "home",
        "to": "drain",
        "carrier": "water",
        "rate": "gutterLoss",
        "label": "Lost in the gutters",
        "unit": "L/day"
      },
      {
        "id": "overflow",
        "from": "tankNode",
        "to": "drain",
        "carrier": "water",
        "rate": "max(0, summerInflow - gardenUse - (tankSize - tank) * drawRate / 100)",
        "label": "Overflow when full",
        "unit": "L/day"
      },
      {
        "id": "watering",
        "from": "tankNode",
        "to": "garden",
        "carrier": "water",
        "rate": "min(gardenUse, summerInflow + tank * drawRate / 100)",
        "label": "Watering from the tank",
        "unit": "L/day"
      },
      {
        "id": "tap",
        "from": "mains",
        "to": "garden",
        "carrier": "water",
        "rate": "max(0, gardenUse - summerInflow - tank * drawRate / 100)",
        "label": "Watering from the tap",
        "unit": "L/day"
      }
    ]
  },
  "ask": [
    {
      "question": "How much roof drains into the tank?",
      "help": "Count only the roof whose downpipes run to the tank.",
      "choices": [
        {
