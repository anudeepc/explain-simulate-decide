      ]
    },
    {
      "question": "How much rain falls where you live in a year?",
      "help": "Your weather service lists the yearly average for your town, in millimetres.",
      "input": "annualRain"
    },
    {
      "question": "How often does it rain in your summer?",
      "choices": [
        {
          "label": "Hardly ever",
          "set": {
            "summerRain": 0
          },
          "source": "assumption"
        },
        {
          "label": "Not sure / a shower now and then",
          "set": {
